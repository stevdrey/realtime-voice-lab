<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.stevdrey.realtimevoicelab.ui.WorkspaceController" styleClass="app-shell">
    <HBox spacing="10" styleClass="app-header">
        <SVGPath content="M1 12h3l3-7 4 14 4-16 4 9h4" styleClass="icon"/>
        <Label text="Realtime Voice Lab" styleClass="app-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="JavaFX Desktop" styleClass="caption"/>
    </HBox>

    <VBox styleClass="workspace" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Region styleClass="status-dot"/>
            <Label id="session-status" text="Disconnected" styleClass="session-status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="modelSelector" id="model-selector" disable="true">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="gpt-realtime-2.1-mini"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>

        <SplitPane id="main-panels" dividerPositions="0.5" VBox.vgrow="ALWAYS">
            <VBox spacing="8" minWidth="260" styleClass="lab-panel">
                <Label text="CONVERSATION" styleClass="panel-title" labelFor="${conversation}"/>
                <ScrollPane fx:id="conversation" id="conversation-content" accessibleText="Conversation"
                            focusTraversable="true" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                            VBox.vgrow="ALWAYS">
                    <content>
                        <StackPane>
                            <Label text="Connect to start a conversation." styleClass="empty-message"/>
                        </StackPane>
                    </content>
                </ScrollPane>
            </VBox>
            <VBox spacing="8" minWidth="260" styleClass="lab-panel">
                <Label text="EVENT INSPECTOR" styleClass="panel-title" labelFor="${eventList}"/>
                <ListView fx:id="eventList" id="event-list" accessibleText="Event Inspector" VBox.vgrow="ALWAYS">
                    <placeholder>
                        <Label text="No events yet." styleClass="empty-message"/>
                    </placeholder>
                </ListView>
            </VBox>
        </SplitPane>

        <StackPane accessibleText="Idle waveform" styleClass="waveform">
            <Region styleClass="waveform-baseline"/>
        </StackPane>

        <VBox alignment="CENTER" spacing="6">
            <HBox alignment="CENTER" spacing="16" fillHeight="false">
                <StackPane fx:id="settingsControl">
                    <Button fx:id="settingsButton" id="settings-button" accessibleText="Settings"
                            disable="true" styleClass="round-control">
                        <graphic>
                            <SVGPath styleClass="icon"
                                     content="M10 2h4l.7 3 2 .9 2.7-1.5 2 3.5-2.2 2.1v3l2.2 2.1-2 3.5
                                              -2.7-1.5-2 .9-.7 3h-4l-.7-3-2-.9-2.7 1.5-2-3.5L4.8 13v-3L2.6 7.9l2-3.5 2.7 1.5 2-.9z
                                              M15 11.5a3 3 0 1 1-6 0 3 3 0 1 1 6 0z"/>
                        </graphic>
                    </Button>
                </StackPane>
                <StackPane fx:id="micControl">
                    <Button fx:id="micButton" id="mic-button" accessibleText="Microphone"
                            disable="true" styleClass="mic-button">
                        <graphic>
                            <SVGPath styleClass="icon"
                                     content="M12 2a4 4 0 0 0-4 4v6a4 4 0 0 0 8 0V6a4 4 0 0 0-4-4z M5 11v1a7 7 0 0 0 14 0v-1 M12 19v4 M8 23h8"/>
                        </graphic>
                    </Button>
                </StackPane>
                <StackPane fx:id="connectControl">
                    <Button fx:id="connectButton" id="connect-button" accessibleText="Connect"
                            disable="true" styleClass="round-control">
                        <graphic>
                            <SVGPath content="M12 2v10 M6.4 5.4a8 8 0 1 0 11.2 0" styleClass="icon"/>
                        </graphic>
                    </Button>
                </StackPane>
            </HBox>
            <Label text="Session controls unavailable" styleClass="caption"/>
        </VBox>

        <HBox id="metrics" spacing="16" styleClass="metrics">
            <VBox spacing="4" prefWidth="0" HBox.hgrow="ALWAYS">
                <Label text="Latency" styleClass="caption"/>
                <Label text="—" accessibleText="Latency unavailable" styleClass="metric-value"/>
            </VBox>
            <VBox spacing="4" prefWidth="0" HBox.hgrow="ALWAYS">
                <Label text="Session" styleClass="caption"/>
                <Label text="—" accessibleText="Session unavailable" styleClass="metric-value"/>
            </VBox>
            <VBox spacing="4" prefWidth="0" HBox.hgrow="ALWAYS">
                <Label text="Est. cost" styleClass="caption"/>
                <Label text="—" accessibleText="Est. cost unavailable" styleClass="metric-value"/>
            </VBox>
        </HBox>
    </VBox>
</VBox>
