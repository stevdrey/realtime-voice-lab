<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="workspace, settings-dialog" prefWidth="460">
    <GridPane hgap="12" vgap="8">
        <Label text="Model" labelFor="${model}"/>
        <ComboBox fx:id="model" id="settings-model" GridPane.columnIndex="1"/>
        <Label text="Voice" labelFor="${voice}" GridPane.rowIndex="1"/>
        <ComboBox fx:id="voice" id="settings-voice" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Mode" labelFor="${mode}" GridPane.rowIndex="2"/>
        <ComboBox fx:id="mode" id="settings-mode" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Turn detection" labelFor="${turnDetection}" GridPane.rowIndex="3"/>
        <ComboBox fx:id="turnDetection" id="settings-turn-detection" GridPane.columnIndex="1"
                  GridPane.rowIndex="3"/>
        <Label text="Preset" labelFor="${preset}" GridPane.rowIndex="4"/>
        <ComboBox fx:id="preset" id="settings-preset" promptText="Custom" GridPane.columnIndex="1"
                  GridPane.rowIndex="4"/>
        <Label text="Tool preset" labelFor="${toolPreset}" GridPane.rowIndex="5"/>
        <ComboBox fx:id="toolPreset" id="settings-tool-preset" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    <Label text="Push to talk uses hold and release. Server VAD and Semantic VAD listen after you click the microphone."
           styleClass="caption" wrapText="true"/>
    <Label text="Instructions" labelFor="${instructions}"/>
    <TextArea fx:id="instructions" id="settings-instructions" wrapText="true" prefRowCount="5"
              accessibleHelp="Up to 4,000 characters" VBox.vgrow="ALWAYS"/>
    <Label fx:id="reconnectHelp" id="settings-reconnect-help" styleClass="caption" wrapText="true"/>
    <Label fx:id="error" text="Session settings are unavailable. Close this dialog and try again."
           styleClass="settings-error" wrapText="true" visible="false"/>
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Cancel" cancelButton="true" onAction="#cancel" styleClass="text-action"/>
        <Button fx:id="applyButton" id="apply-settings" defaultButton="true" onAction="#apply"
                styleClass="text-action"/>
    </HBox>
</VBox>
