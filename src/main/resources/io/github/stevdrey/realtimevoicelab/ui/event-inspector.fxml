<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.stevdrey.realtimevoicelab.ui.EventInspectorController"
      spacing="8" minWidth="260" styleClass="lab-panel,event-inspector">
    <Label text="EVENT INSPECTOR" styleClass="panel-title" labelFor="${eventList}"/>
    <TextField fx:id="eventFilter" id="event-filter" promptText="Filter by type, direction or ID"
               accessibleText="Filter events by type, direction or ID" minWidth="0"/>
    <ListView fx:id="eventList" id="event-list" accessibleText="Event Inspector"
              minHeight="32" fixedCellSize="26" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label fx:id="eventEmpty" text="No events yet." styleClass="empty-message"/>
        </placeholder>
    </ListView>
    <TitledPane id="event-detail-pane" text="Redacted JSON" expanded="false" animated="false">
        <TextArea fx:id="eventDetail" id="event-detail" accessibleText="Redacted event JSON"
                  promptText="Select an event to inspect." editable="false" wrapText="true" prefRowCount="4"/>
    </TitledPane>
</VBox>
