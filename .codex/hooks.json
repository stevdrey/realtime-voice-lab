{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "root=$(git rev-parse --show-toplevel) && node \"$root/.agents/scripts/pr-size-preflight.mjs\" --hook || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
